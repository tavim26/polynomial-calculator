<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.tavim26.polynomial.gui.CalculatorController"
      stylesheets="@calculator.css"
      alignment="TOP_CENTER" spacing="14">

   <padding>
      <Insets top="20" right="16" bottom="20" left="16"/>
   </padding>

   <Label text="Polynomial Calculator" styleClass="title"/>

   <!-- Input and result fields -->
   <VBox spacing="10">
      <HBox spacing="10" alignment="CENTER_LEFT">
         <Label text="P1" styleClass="field-label"/>
         <TextField fx:id="field1" promptText="e.g. 3x^2 - x + 5" HBox.hgrow="ALWAYS"/>
      </HBox>
      <HBox spacing="10" alignment="CENTER_LEFT">
         <Label text="P2" styleClass="field-label"/>
         <TextField fx:id="field2" promptText="e.g. x - 1" HBox.hgrow="ALWAYS"/>
      </HBox>
      <HBox spacing="10" alignment="CENTER_LEFT">
         <Label text="R" styleClass="field-label"/>
         <TextField fx:id="resultField" editable="false" focusTraversable="false"
                    HBox.hgrow="ALWAYS"/>
      </HBox>
   </VBox>

   <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" minHeight="20"/>

   <!-- Operations -->
   <VBox spacing="10" alignment="CENTER">
      <HBox spacing="10" alignment="CENTER">
         <Button text="ADD" styleClass="operation" onAction="#onAddClick"/>
         <Button text="SUB" styleClass="operation" onAction="#onSubtractClick"/>
         <Button text="MUL" styleClass="operation" onAction="#onMultiplyClick"/>
      </HBox>
      <HBox spacing="10" alignment="CENTER">
         <Button text="DIV" styleClass="operation" disable="true"/>
         <Button text="DER" styleClass="operation" onAction="#onDerivativeClick">
            <tooltip>
               <Tooltip text="Derivative of P1"/>
            </tooltip>
         </Button>
         <Button text="INT" styleClass="operation" onAction="#onIntegralClick">
            <tooltip>
               <Tooltip text="Integral of P1"/>
            </tooltip>
         </Button>
      </HBox>
   </VBox>

   <!-- Keypad -->
   <VBox spacing="5" alignment="CENTER">
      <HBox spacing="5" alignment="CENTER">
         <Button text="1" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="2" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="3" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Region prefWidth="12"/>
         <Button text="0" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="x" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="^" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
      </HBox>
      <HBox spacing="5" alignment="CENTER">
         <Button text="4" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="5" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="6" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Region prefWidth="12"/>
         <Button text="+" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="-" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="del" styleClass="key, key-small" focusTraversable="false" onAction="#onDeleteClick"/>
      </HBox>
      <HBox spacing="5" alignment="CENTER">
         <Button text="7" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="8" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Button text="9" styleClass="key" focusTraversable="false" onAction="#onKeypadClick"/>
         <Region prefWidth="12"/>
         <Button text="←" styleClass="key" focusTraversable="false" onAction="#onCaretLeftClick"/>
         <Button text="→" styleClass="key" focusTraversable="false" onAction="#onCaretRightClick"/>
         <Button text="C" styleClass="key" focusTraversable="false" onAction="#onClearClick"/>
      </HBox>
   </VBox>
</VBox>